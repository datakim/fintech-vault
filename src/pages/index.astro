---
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import KnowledgeGraph from "@/components/KnowledgeGraph.astro";
import { getKnowledgeGraph, topicOf } from "@/utils/knowledgeGraph";
import config from "@/config";

const { socials } = config;

// 2026-10-26부터 홈은 영어가 기본이다. 한국어 글은 /posts/에 그대로 있다.
const enPosts = (await getCollection("en", ({ data }) => !data.draft)).sort(
  (a, b) =>
    new Date(b.data.pubDatetime).getTime() -
    new Date(a.data.pubDatetime).getTime()
);
const recentPosts = enPosts.slice(0, 6);

const graph = await getKnowledgeGraph("en");
const byId = new Map(graph.nodes.map(n => [n.id, n]));
const topicCards = graph.topics
  .filter(t => t.count > 0 && t.id !== "notes")
  .map(t => ({
    ...t,
    posts: graph.nodes
      .filter(n => n.topic === t.id)
      .sort((a, b) => b.degree - a.degree)
      .slice(0, 3),
  }));

const description =
  "Notes from working in fintech and studying AI on the side, by Elliot Kim.";

// 홈 페이지용 WebSite/Person 구조화 데이터 — 검색엔진이 사이트의 정체와 저자를 명확히 인식하도록.
const linkedin = socials.find(s => s.name === "linkedin")?.url;
const authorUrl = config.site.profile || linkedin;
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${config.site.url}/#website`,
  name: config.site.title,
  url: config.site.url,
  description,
  inLanguage: ["en", "ko"],
  author: {
    "@type": "Person",
    "@id": `${config.site.url}/#person`,
    name: config.site.author,
    ...(authorUrl && { url: authorUrl }),
    ...(linkedin && { sameAs: [linkedin] }),
  },
  publisher: {
    "@type": "Person",
    "@id": `${config.site.url}/#person`,
  },
};
---

<Layout lang="en" {description}>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteSchema)}
    />
  </Fragment>

  <div data-theme="dark" class="brand-band text-foreground">
    <Header />
    <main
      id="main-content"
      data-layout="index"
      data-home-path="/"
      class="app-wide"
    >
      <section
        id="hero"
        class="grid items-center gap-6 pt-12 pb-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] lg:gap-4 lg:pt-16 lg:pb-20"
      >
        <div class="relative z-10 max-w-xl">
          <p class="eyebrow flex items-center gap-2.5">
            <span class="bg-accent inline-block size-1.5 rounded-full"></span>
            Fintech · AI · Notes
          </p>
          <h1 class="display mt-6 text-[2.6rem] sm:text-[3.4rem]">
            Notes from fintech<br />and AI.
          </h1>
          <p class="text-muted-foreground mt-6 text-[15px] leading-7">
            Things I run into working in fintech, and notes from studying AI on
            the side.
          </p>
          <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
            <a
              href="/en/"
              class="inline-flex items-center gap-2 rounded-lg bg-[#d5dfca] px-5 py-3 text-[14px] font-semibold text-[#1d3530] transition-colors hover:bg-[#e2ead8]"
            >
              Latest posts <span aria-hidden="true">→</span>
            </a>
            <a
              href="/graph/"
              class="hover:text-accent inline-flex items-center gap-2 text-[14px] font-medium transition-colors"
            >
              Open the map <span aria-hidden="true">→</span>
            </a>
            <a
              href="/posts/"
              lang="ko"
              class="text-muted-foreground hover:text-foreground text-[14px] transition-colors"
            >
              한국어
            </a>
          </div>
          <dl class="mt-12 flex gap-10">
            <div>
              <dt class="eyebrow">Posts</dt>
              <dd class="mt-1 text-2xl font-medium tracking-tight">
                {graph.nodes.length}
              </dd>
            </div>
            <div>
              <dt class="eyebrow">Links</dt>
              <dd class="mt-1 text-2xl font-medium tracking-tight">
                {graph.edges.length}
              </dd>
            </div>
            <div>
              <dt class="eyebrow">Topics</dt>
              <dd class="mt-1 text-2xl font-medium tracking-tight">
                {topicCards.length}
              </dd>
            </div>
          </dl>
        </div>

        <div class="-mx-5 sm:mx-0">
          <KnowledgeGraph variant="hero" lang="en" />
        </div>
      </section>
    </main>
  </div>

  <section class="app-wide pt-20">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Latest</p>
        <h2 class="display mt-3 text-3xl">Recent posts</h2>
      </div>
      <a
        href="/en/"
        class="text-muted-foreground hover:text-foreground text-[14px] transition-colors"
      >
        All posts <span aria-hidden="true">→</span>
      </a>
    </div>
    <ol class="mt-8">
      {
        recentPosts.map((post, i) => {
          const topic = topicOf(post.data.tags);
          const node = byId.get(post.id);
          return (
            <li class="border-border/80 border-t">
              <a
                href={`/en/${post.id}/`}
                class="group grid gap-x-8 gap-y-2 py-7 sm:grid-cols-[3rem_9rem_minmax(0,1fr)_6rem]"
              >
                <span class="text-muted-foreground text-[13px] tabular-nums">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span class="eyebrow flex items-start gap-2 pt-0.5">
                  <span
                    class="mt-[5px] inline-block size-1.5 shrink-0 rounded-full"
                    style={`background:${topic.color};box-shadow:0 0 0 1px rgb(0 0 0 / 0.12)`}
                  />
                  {topic.eyebrow}
                </span>
                <span>
                  <span class="group-hover:text-accent block text-[19px] leading-snug font-medium tracking-[-0.02em] transition-colors">
                    {post.data.title}
                  </span>
                  <span class="text-muted-foreground mt-2 line-clamp-2 text-[14.5px] leading-6">
                    {post.data.description}
                  </span>
                </span>
                <span class="text-muted-foreground text-[13px] tabular-nums sm:text-end">
                  {dayjs(post.data.pubDatetime).format("YYYY.MM.DD")}
                  {node && node.degree > 0 && (
                    <span class="mt-1 block opacity-80">
                      {node.degree} {node.degree === 1 ? "link" : "links"}
                    </span>
                  )}
                </span>
              </a>
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="app-wide pt-20">
    <p class="eyebrow">Topics</p>
    <h2 class="display mt-3 text-3xl">By topic</h2>
    <div
      class="bg-border/80 border-border/80 mt-8 grid gap-px overflow-hidden rounded-2xl border sm:grid-cols-2 lg:grid-cols-3"
    >
      {
        topicCards.map(t => (
          <a
            href={`/graph/?topic=${t.id}`}
            class="bg-background hover:bg-surface group flex flex-col p-7 transition-colors"
          >
            <div class="flex items-center justify-between">
              <span class="eyebrow flex items-center gap-2">
                <span
                  class="inline-block size-2 rounded-full"
                  style={`background:${t.color};box-shadow:0 0 0 1px rgb(0 0 0 / 0.12)`}
                />
                {t.eyebrow}
              </span>
              <span class="text-muted-foreground text-[13px]">
                {t.count} {t.count === 1 ? "post" : "posts"}
              </span>
            </div>
            <h3 class="mt-4 text-xl font-medium tracking-[-0.02em]">
              {t.name}
            </h3>
            <ul class="text-muted-foreground mt-4 space-y-1.5 text-[13.5px] leading-6">
              {t.posts.map(p => (
                <li class="line-clamp-1">{p.short}</li>
              ))}
            </ul>
            <span class="group-hover:text-accent mt-6 text-[13px] font-medium transition-colors">
              On the map <span aria-hidden="true">→</span>
            </span>
          </a>
        ))
      }
      <a
        href="/graph/"
        data-theme="dark"
        class="brand-band text-foreground group flex flex-col justify-between p-7"
      >
        <span class="eyebrow">Map</span>
        <span class="mt-4 block text-xl font-medium tracking-[-0.02em]">
          {graph.nodes.length} posts, {graph.edges.length} links
        </span>
        <span class="group-hover:text-accent mt-6 text-[13px] font-medium transition-colors">
          Open the map <span aria-hidden="true">→</span>
        </span>
      </a>
    </div>
  </section>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
