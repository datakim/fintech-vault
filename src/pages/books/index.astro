---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const books = await getCollection("books", ({ data }) => !data.draft);

// Group by bookTitle (fallback "Other")
const grouped = new Map<string, typeof books>();
for (const b of books) {
  const key = b.data.bookTitle ?? "Other";
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(b);
}
// Within each group, sort by pubDatetime ascending so chapter 1 comes first.
for (const arr of grouped.values()) {
  arr.sort(
    (a, b) =>
      new Date(a.data.pubDatetime).getTime() -
      new Date(b.data.pubDatetime).getTime()
  );
}

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<Layout title={`${t.pages.booksTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.booksTitle} pageDesc={t.pages.booksDesc}>
    {
      books.length === 0 ? (
        <p class="text-muted-foreground mt-6">
          곧 책 연습문제 해답이 챕터별로 올라옵니다.
        </p>
      ) : (
        [...grouped.entries()].map(([bookTitle, entries]) => (
          <section class="mt-10">
            <h2 class="text-xl font-semibold tracking-wide">{bookTitle}</h2>
            <ul>
              {entries.map(entry => (
                <li class="my-4">
                  <a
                    href={getRelativeLocaleUrl(locale, `books/${entry.id}`)}
                    class:list={[
                      "text-accent inline-block text-lg font-medium",
                      "decoration-dashed underline-offset-4 hover:underline",
                    ]}
                  >
                    <h3>{entry.data.title}</h3>
                  </a>
                  <Datetime
                    pubDatetime={entry.data.pubDatetime}
                    modDatetime={entry.data.modDatetime}
                    timezone={entry.data.timezone}
                  />
                  <p>{entry.data.description}</p>
                </li>
              ))}
            </ul>
          </section>
        ))
      )
    }
  </Main>

  <Footer />
</Layout>
