---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import dayjs from "dayjs";
import { topicOf } from "@/utils/knowledgeGraph";
import config from "@/config";

const posts = (await getCollection("en", ({ data }) => !data.draft)).sort(
  (a, b) =>
    new Date(b.data.pubDatetime).getTime() -
    new Date(a.data.pubDatetime).getTime()
);

---

<Layout
  title={`Posts | ${config.site.title}`}
  description="Posts on fintech, financial AI and LLM systems by Elliot Kim."
  lang="en"
>
  <Header />

  <Main
    pageTitle="Posts"
    pageDesc="Most posts here also have a Korean version, linked at the top of each post."
  >
    {
      posts.length === 0 ? (
        <p class="text-muted-foreground mt-6">Posts are on the way.</p>
      ) : (
        <ul>
          {posts.map(entry => {
            const topic = topicOf(entry.data.tags);
            return (
              <li class="border-border/80 border-b first:border-t">
                <a href={`/en/${entry.id}/`} class="group block py-6">
                  <span class="eyebrow flex items-center gap-2">
                    <span
                      class="inline-block size-1.5 rounded-full"
                      style={`background:${topic.color};box-shadow:0 0 0 1px rgb(0 0 0 / 0.15)`}
                    />
                    {topic.eyebrow}
                    <span aria-hidden="true">·</span>
                    <time class="tracking-[0.12em]">
                      {dayjs(entry.data.pubDatetime).format("YYYY.MM.DD")}
                    </time>
                  </span>
                  <h2 class="group-hover:text-accent mt-2.5 text-[19px] leading-snug font-medium tracking-[-0.02em] transition-colors">
                    {entry.data.title}
                  </h2>
                  <p class="text-muted-foreground mt-2 line-clamp-2 text-[14.5px] leading-6">
                    {entry.data.description}
                  </p>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
