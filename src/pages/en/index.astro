---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import config from "@/config";

const posts = (await getCollection("en", ({ data }) => !data.draft)).sort(
  (a, b) =>
    new Date(b.data.pubDatetime).getTime() -
    new Date(a.data.pubDatetime).getTime()
);

const locale = Astro.currentLocale ?? config.site.lang;
---

<Layout
  title={`English | ${config.site.title}`}
  description="Notes on financial AI, LLM applications, and problems hit in production — written in English."
>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="English"
    pageDesc="Selected notes from this blog, written in English. Topics range from world models and ontologies to LLM evaluation and what breaks in production."
  >
    {
      posts.length === 0 ? (
        <p class="text-muted-foreground mt-6">Posts are on the way.</p>
      ) : (
        <ul>
          {posts.map(entry => (
            <li class="my-6">
              <a
                href={getRelativeLocaleUrl(locale, `en/${entry.id}`)}
                class:list={[
                  "text-accent inline-block text-lg font-medium",
                  "decoration-dashed underline-offset-4 hover:underline",
                ]}
              >
                <h2>{entry.data.title}</h2>
              </a>
              <Datetime
                pubDatetime={entry.data.pubDatetime}
                modDatetime={entry.data.modDatetime}
                timezone={entry.data.timezone}
              />
              <p>{entry.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
