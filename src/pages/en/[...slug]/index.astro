---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { slugifyStr } from "@/utils/slugify";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("en", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"en"> };

const { post } = Astro.props;
const {
  title,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  koSlug,
} = post.data;

const { Content } = await render(post);

const locale = Astro.currentLocale ?? config.site.lang;
const koHref = koSlug ? getRelativeLocaleUrl(locale, `posts/${koSlug}`) : null;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
>
  <Header />

  <main id="main-content" class="app-layout mt-8" data-pagefind-body>
    <h1
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class="text-accent inline-block text-2xl font-bold sm:text-3xl"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
    </div>

    {
      koHref && (
        <p class="text-muted-foreground my-4 text-sm">
          이 글의 한국어판:{" "}
          <a
            href={koHref}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            한국어로 읽기
          </a>
        </p>
      )
    }

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>
  </main>

  <Footer />
</PostLayout>
