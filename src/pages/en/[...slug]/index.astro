---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import PostLayout from "@/layouts/PostLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Datetime from "@/components/Datetime.astro";
import { slugifyStr } from "@/utils/slugify";
import RelatedPosts from "@/components/RelatedPosts.astro";
import { topicOf } from "@/utils/knowledgeGraph";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("en", ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = { post: CollectionEntry<"en"> };

const { post } = Astro.props;
const {
  title,
  description,
  canonicalURL,
  pubDatetime,
  modDatetime,
  timezone,
  koSlug,
  tags,
  ogImage: initOgImage,
} = post.data;
const topic = topicOf(tags);

const { Content } = await render(post);

const locale = Astro.currentLocale ?? config.site.lang;
const koHref = koSlug ? getRelativeLocaleUrl(locale, `posts/${koSlug}`) : null;

let ogImageUrl: string | undefined =
  typeof initOgImage === "string" ? initOgImage : initOgImage?.src;
if (!ogImageUrl && config.features.dynamicOgImage) {
  ogImageUrl = `/en/${post.id}/index.png`;
}
const ogImage = ogImageUrl
  ? new URL(ogImageUrl, Astro.url.origin).href
  : undefined;
---

<PostLayout
  title={`${title} | ${config.site.title}`}
  description={description}
  ogImage={ogImage}
  canonicalURL={canonicalURL}
  pubDatetime={pubDatetime}
  modDatetime={modDatetime}
  tags={tags}
  lang="en"
>
  <Header />

  <main id="main-content" class="app-layout mt-8" data-pagefind-body>
    <p class="eyebrow mt-6 flex items-center gap-2.5">
      <span
        class="inline-block size-1.5 rounded-full"
        style={`background:${topic.color};box-shadow:0 0 0 1px rgb(0 0 0 / 0.15)`}
      ></span>
      {topic.eyebrow}
    </p>
    <h1
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
      class="mt-4 inline-block text-[1.9rem] leading-tight font-semibold tracking-[-0.035em] sm:text-[2.4rem]"
    >
      {title}
    </h1>

    <div class="my-2 flex items-center gap-2">
      <Datetime {pubDatetime} {modDatetime} {timezone} size="lg" />
      {
        koHref && (
          <a
            href={koHref}
            lang="ko"
            class="text-muted-foreground hover:text-foreground ms-auto text-[13px] underline-offset-4 transition-colors hover:underline"
          >
            한국어로 읽기
          </a>
        )
      }
    </div>

    <article
      id="article"
      class:list={[
        "mt-8 w-full",
        "app-prose max-w-app",
        "prose-pre:bg-(--shiki-light-bg) dark:prose-pre:bg-(--shiki-dark-bg)",
      ]}
    >
      <Content />
    </article>

    <RelatedPosts slug={post.id} lang="en" />
  </main>

  <Footer />
</PostLayout>
