---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";

type Props = {
  page: Page<CollectionEntry<"posts">>;
};

const { page } = Astro.props;

const t = useTranslations(Astro.currentLocale);

// Astro의 page.url은 끝 슬래시가 없다(/posts, /tags/x/2). 사이트 canonical은 슬래시 붙은
// 주소라서, 링크도 맞춰야 구글이 같은 목록 페이지를 주소 두 개로 크롤링하지 않는다.
const withSlash = (url?: string) =>
  url && !url.endsWith("/") ? `${url}/` : url;
const prevUrl = withSlash(page.url.prev);
const nextUrl = withSlash(page.url.next);
---

{
  page.lastPage > 1 && (
    <nav
      class="mt-auto mb-8 flex justify-center gap-4"
      role="navigation"
      aria-label="Pagination Navigation"
    >
      <LinkButton
        disabled={!prevUrl}
        href={prevUrl as string}
        class:list={["select-none", { "opacity-50": !prevUrl }]}
        aria-label={t.a11y.goToPreviousPage}
      >
        <IconArrowLeft class="inline-block rtl:rotate-180" />
        {t.pagination.prev}
      </LinkButton>
      {page.currentPage} / {page.lastPage}
      <LinkButton
        disabled={!nextUrl}
        href={nextUrl as string}
        class:list={["select-none", { "opacity-50": !nextUrl }]}
        aria-label={t.a11y.goToNextPage}
      >
        {t.pagination.next}
        <IconArrowRight class="inline-block rtl:rotate-180" />
      </LinkButton>
    </nav>
  )
}
