---
import type { HTMLAttributes } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import Socials from "./Socials.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const t = useTranslations(Astro.currentLocale);
const locale = Astro.currentLocale ?? config.site.lang;
const currentYear = new Date().getFullYear();
---

<footer
  class:list={["app-wide", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border/70 mt-16 flex flex-col gap-6 border-t py-8 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex flex-col gap-2">
      <span class="eyebrow">{config.site.title}</span>
      <span class="text-muted-foreground text-[13px]">
        {t.footer.copyright} &#169; {currentYear} {config.site.author}
      </span>
    </div>
    <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a
        href={getRelativeLocaleUrl(locale, "graph")}
        class="eyebrow hover:text-foreground transition-colors">Map</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "tags")}
        class="eyebrow hover:text-foreground transition-colors">Tags</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "archives")}
        class="eyebrow hover:text-foreground transition-colors">Archives</a
      >
      <a
        href={getRelativeLocaleUrl(locale, "rss.xml")}
        class="eyebrow hover:text-foreground transition-colors">RSS</a
      >
      <Socials />
    </div>
  </div>
</footer>
