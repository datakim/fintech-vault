---
/*
 * 댓글 (giscus, 2026-11-02)
 * 댓글은 저장소의 GitHub Discussions에 쌓인다. 한국어판과 영문판이 같은 term을 쓰면
 * 한 스레드를 함께 쓴다. categoryId가 비어 있으면 아무것도 그리지 않는다.
 * 값은 https://giscus.app 에서 저장소를 넣으면 나온다.
 */
const GISCUS = {
  repo: "datakim/fintech-vault",
  repoId: "R_kgDOSkq5rQ",
  category: "Announcements",
  categoryId: "DIC_kwDOSkq5rc4DKQI_",
};

type Props = {
  /** 스레드를 가르는 값. 보통 한국어 글 슬러그 */
  term: string;
  lang?: "en" | "ko";
};

const { term, lang = "en" } = Astro.props;
const enabled = Boolean(GISCUS.categoryId);
const themes = {
  light: new URL("/giscus-light.css", Astro.url).href,
  dark: new URL("/giscus-dark.css", Astro.url).href,
};
---

{
  enabled && (
    <section class="comments mt-14" aria-labelledby="comments-title">
      <h2
        id="comments-title"
        class="text-[19px] font-semibold tracking-[-0.02em]"
      >
        {lang === "ko" ? "댓글" : "Comments"}
      </h2>
      <p class="text-muted-foreground mt-1.5 text-[13px] leading-6">
        {lang === "ko"
          ? "GitHub 계정으로 남길 수 있다. 한국어판과 영문판이 같은 댓글을 공유한다."
          : "Sign in with GitHub to comment. The English and Korean versions share one thread."}
      </p>
      <div
        class="giscus-host mt-6"
        data-repo={GISCUS.repo}
        data-repo-id={GISCUS.repoId}
        data-category={GISCUS.category}
        data-category-id={GISCUS.categoryId}
        data-term={term}
        data-lang={lang}
        data-theme-light={themes.light}
        data-theme-dark={themes.dark}
      />
    </section>
  )
}

<script>
  const currentTheme = (host: HTMLElement) =>
    document.documentElement.dataset.theme === "dark"
      ? host.dataset.themeDark!
      : host.dataset.themeLight!;

  // 글마다 giscus 스크립트를 새로 붙인다(화면 전환 후에도).
  function mount() {
    const host = document.querySelector<HTMLElement>(".giscus-host");
    if (!host || host.dataset.mounted) return;
    host.dataset.mounted = "1";
    const ds = host.dataset;
    const s = document.createElement("script");
    s.src = "https://giscus.app/client.js";
    s.async = true;
    s.crossOrigin = "anonymous";
    const attrs: Record<string, string> = {
      "data-repo": ds.repo!,
      "data-repo-id": ds.repoId!,
      "data-category": ds.category!,
      "data-category-id": ds.categoryId!,
      "data-mapping": "specific",
      "data-term": ds.term!,
      "data-strict": "1",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "top",
      "data-theme": currentTheme(host),
      "data-lang": ds.lang!,
      "data-loading": "lazy",
    };
    for (const [k, v] of Object.entries(attrs)) s.setAttribute(k, v);
    host.appendChild(s);
  }

  // 사이트 테마를 바꾸면 댓글 창도 따라 바꾼다.
  new MutationObserver(() => {
    const host = document.querySelector<HTMLElement>(".giscus-host");
    const frame = document.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame"
    );
    if (!host || !frame?.contentWindow) return;
    frame.contentWindow.postMessage(
      { giscus: { setConfig: { theme: currentTheme(host) } } },
      "https://giscus.app"
    );
  }).observe(document.documentElement, { attributeFilter: ["data-theme"] });

  document.addEventListener("astro:page-load", mount);
</script>
